  "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
},
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "argon2": "^0.41.1",
    "axios": "^1.16.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.305.0",
    "nodemailer": "^8.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.2",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^8.0.13"
