{
  "name": "sentinel-edge-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
  "dev": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run frontend\"",
  "frontend": "npm --prefix frontend run dev",
  "backend": "node backend/server/index.mjs",
  "build": "tsc && vite build",
