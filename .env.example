# Sentinel Edge AI backend environment variables
#
# Current backend code uses Supabase REST for user storage.
# If these are missing, the server will fall back to an in-memory dev store.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USERS_TABLE=users

# Camera host (used for stream/snapshot URLs)
CAMERA_HOST=http://100.94.124.9:8080

# Server port
PORT=5000

